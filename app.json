{
  "expo": {
    "name": "SJ Battery Pack",
    "slug": "SJBatteryPackApp",
    "scheme": "sjbatterypack",
    "version": "2.1.18",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "runtimeVersion": "2.1.18",
    "updates": {
      "url": "https://u.expo.dev/d4824861-c576-4382-91d9-c7ef0f26cf5f",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#001E22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sjbatterypack.myapp",
      "buildNumber": "2.1.18",
      "usesAppleSignIn": true,
      "icon": "./assets/images/icon.png",
      "splash": {
        "image": "./assets/images/splash-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#001E22"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "SJ Battery Pack needs camera access to scan gameday QR codes and collect digital win passport stamps.",
        "NSPhotoLibraryUsageDescription": "SJ Battery Pack needs access to your photo library to share high-resolution photos in the Reef Fan Gallery.",
        "NSPhotoLibraryAddUsageDescription": "SJ Battery Pack needs permission to save high-resolution fan photos directly to your camera roll.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.766194485121-oagm77katqfkibgri9qjan93t4dqe9so"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sjbatterypack.myapp",
      "versionCode": 64,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#001E22"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SJ Battery Pack needs camera access to scan gameday QR codes and collect digital win passport stamps."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#001E22"
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SJ Battery Pack access to share gameday photos in the Fan Gallery."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow SJ Battery Pack access to view your photo gallery.",
          "savePhotosPermission": "Allow SJ Battery Pack to save high-resolution photos to your camera roll.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "1.9.24"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4824861-c576-4382-91d9-c7ef0f26cf5f"
      }
    }
  }
}